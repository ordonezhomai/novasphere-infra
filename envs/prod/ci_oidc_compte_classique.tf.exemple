# =====================================================================
# DOCUMENTAIRE - NON APPLIQUE DANS LE LEARNER LAB
# ---------------------------------------------------------------------
# Extension .exemple : Terraform ignore ce fichier (il ne lit que *.tf).
# Dans le lab, iam:CreateRole et la creation d'un fournisseur OIDC sont
# refuses. La CI utilise donc les identifiants de SESSION du lab (valables
# quatre heures) copies dans les secrets du depot par scripts/ci-secrets.sh.
#
# Sur un compte AWS classique, on renommerait ce fichier en .tf et on
# supprimerait les secrets AWS_* du depot : GitHub emet un jeton OIDC signe
# a chaque execution, AWS le verifie et delivre des credentials temporaires
# (une heure) pour ce role seulement. Aucun secret stocke.
# =====================================================================

# Fournisseur d'identite GitHub : un seul par compte AWS.
# A creer une fois (par exemple depuis envs/dev) puis a lire par data dans envs/prod.
resource "aws_iam_openid_connect_provider" "github" {
  url            = "https://token.actions.githubusercontent.com"
  client_id_list = ["sts.amazonaws.com"]
  # Pas de thumbprint_list : optionnel depuis le provider 5.81, AWS valide
  # le fournisseur GitHub avec sa propre bibliotheque d'autorites.
}

# Role assume par la CI, un par environnement
resource "aws_iam_role" "ci" {
  name = "novasphere-ci-${var.environment}"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Federated = aws_iam_openid_connect_provider.github.arn }
      Action    = "sts:AssumeRoleWithWebIdentity"
      Condition = {
        # Le jeton doit etre destine a STS...
        StringEquals = {
          "token.actions.githubusercontent.com:aud" = "sts.amazonaws.com"
        }
        # ...et venir de CE depot. Pour prod : environnement GitHub protege seulement.
        StringLike = {
          "token.actions.githubusercontent.com:sub" = var.environment == "prod" ? "repo:ordonezhomai/novasphere-infra:environment:prod" : "repo:ordonezhomai/novasphere-infra:*"
        }
      }
    }]
  })
}

# Droits restreints aux services utilises par le projet (pas d'AdministratorAccess)
resource "aws_iam_role_policy" "ci" {
  name = "terraform-novasphere-${var.environment}"
  role = aws_iam_role.ci.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "StateTerraform"
        Effect   = "Allow"
        Action   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"]
        Resource = ["arn:aws:s3:::novasphere-tfstate-hor", "arn:aws:s3:::novasphere-tfstate-hor/novasphere/${var.environment}/*"]
      },
      {
        Sid      = "InfrastructureWeb"
        Effect   = "Allow"
        Action   = ["ec2:*", "elasticloadbalancing:*", "autoscaling:*"]
        Resource = "*"
        Condition = {
          StringEquals = { "aws:RequestedRegion" = "us-east-1" }
        }
      },
      {
        Sid      = "SecretDeLEnvironnement"
        Effect   = "Allow"
        Action   = ["ssm:PutParameter", "ssm:GetParameter", "ssm:DeleteParameter", "ssm:AddTagsToResource", "ssm:ListTagsForResource", "ssm:DescribeParameters"]
        Resource = "arn:aws:ssm:us-east-1:${data.aws_caller_identity.current.account_id}:parameter/novasphere/${var.environment}/*"
      },
      {
        Sid      = "TransmettreLeRoleDesInstances"
        Effect   = "Allow"
        Action   = "iam:PassRole"
        Resource = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:role/novasphere-${var.environment}-web"
      }
    ]
  })
}

output "ci_role_arn" {
  description = "A renseigner dans la variable de depot AWS_ROLE_DEV / AWS_ROLE_PROD"
  value       = aws_iam_role.ci.arn
}

# Cote workflow, a la place des trois secrets AWS_* :
#
#   permissions:
#     id-token: write      # demander le jeton OIDC
#     contents: read
#     pull-requests: write
#
#   - uses: aws-actions/configure-aws-credentials@v4
#     with:
#       role-to-assume: ${{ vars.AWS_ROLE_DEV }}
#       aws-region: us-east-1
