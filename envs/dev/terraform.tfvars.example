# Copier en terraform.tfvars (ignore par Git) : cp terraform.tfvars.example terraform.tfvars
# Le mot de passe n'est JAMAIS ici : export TF_VAR_db_password="..."
owner          = "hor"
environment    = "dev"
instance_type  = "t3.micro"
vpc_cidr       = "10.0.0.0/16"
public_subnets = ["10.0.1.0/24", "10.0.2.0/24"]
asg_min_size   = 2
asg_max_size   = 4
